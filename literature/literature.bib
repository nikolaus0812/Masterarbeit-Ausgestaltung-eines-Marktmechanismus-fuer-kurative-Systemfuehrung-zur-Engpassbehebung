@article{bukhsh_balancing_2024,
	title = {Balancing the great {British} electricity system — {Bulk} dispatch optimisation},
	volume = {234},
	issn = {03787796},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S037877962400600X},
	doi = {10.1016/j.epsr.2024.110714},
	abstract = {The Balancing Mechanism, managed by the British electricity system operator, National Grid ESO, is designed to maintain a balance between electricity generation and demand. It achieves this by purchasing extra generation (or demand reduction) through accepted offers and extra demand (or generation reduction) through accepted bids from Balancing Mechanism Units (BMUs) in real-time. The current manual approach for instructing BMUs becomes increasingly challenging as access to the market widens and the number of BMUs grows. This paper introduces a proof-of-concept optimisation model to assist Control Room engineers in making optimal decisions for a large number of BMUs. We outline the requirements for instructing BMUs, provide their mathematical formulation, and illustrate this using simple examples. Computational performance results based on test cases with up to 500 units are presented.},
	language = {en},
	urldate = {2026-04-07},
	journal = {Electric Power Systems Research},
	author = {Bukhsh, Waqquas and Bejan, Andrei},
	month = sep,
	year = {2024},
	pages = {110714},
	file = {PDF:files/11/Bukhsh und Bejan - 2024 - Balancing the great British electricity system — Bulk dispatch optimisation.pdf:application/pdf},
}

@inproceedings{einsiedler_analysis_2025,
	address = {Lisbon, Portugal},
	title = {Analysis of {Electricity} {Market} {Models} for {Future} {Power} {Systems}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3315-1278-1},
	url = {https://ieeexplore.ieee.org/document/11050257/},
	doi = {10.1109/EEM64765.2025.11050257},
	abstract = {Electricity market models play a crucial role in addressing various research questions related to future electricity supply systems. As the energy transition progresses, the electricity market must evolve to incorporate renewable energy and demand-side flexibility while ensuring adequate investment incentives for reliable capacity. The design of electricity market models for future electricity markets requires a multifaceted approach that considers temporal, spatial, methodological, technical, and integrative criteria. A comprehensive review of 30 existing models identifies opportunities for advancement, particularly in the area of simulating the future electricity market. The analysis of these models indicates areas where improvements can be made in terms of realistic modeling. These areas include the modeling of human behavior, enhanced spatial resolution, representation of multiple electricity markets, and improved uncertainty modeling.},
	language = {en},
	urldate = {2026-04-07},
	booktitle = {2025 21st {International} {Conference} on the {European} {Energy} {Market} ({EEM})},
	publisher = {IEEE},
	author = {Einsiedler, Jana and Von Hindte, Greta and Mori, Valerio and Moser, Albert},
	month = may,
	year = {2025},
	pages = {1--9},
	file = {PDF:files/12/Einsiedler et al. - 2025 - Analysis of Electricity Market Models for Future Power Systems.pdf:application/pdf},
}

@inproceedings{blank_determination_2024,
	address = {Istanbul, Turkiye},
	title = {Determination of {Locational} {Marginal} {Redispatch} {Prices} of a {Mixed}-{Integer} {Congestion} {Management} {Problem}},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3503-8174-0},
	url = {https://ieeexplore.ieee.org/document/10608892/},
	doi = {10.1109/EEM60825.2024.10608892},
	abstract = {Locational marginal prices (LMP) are the basis for many studies on energy economic questions. LMPs are determined from the dual solution of the primary optimization problem. If the optimization problem is formulated linearly, dual variables can be read from the closed-form solution using commercially available solvers such as CPLEX or GUROBI. Mixed integer problems (MILP) are no longer possible, and the dual solution's decomposition and iterative determination are required. This paper presents an extended Lagrangian method for congestion management simulation, which can determine locational marginal redispatch prices (LMRP) by considering mixed-integer constraints of thermal power plants considering startup and shutdown costs.},
	language = {en},
	urldate = {2026-04-07},
	booktitle = {2024 20th {International} {Conference} on the {European} {Energy} {Market} ({EEM})},
